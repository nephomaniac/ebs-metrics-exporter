apiVersion: apps/v1
kind: Deployment
metadata:
  name: ebs-metrics-reconciler
  namespace: {{ .config.namespace }}
  labels:
    app.kubernetes.io/name: ebs-metrics-reconciler
    app.kubernetes.io/part-of: ebs-metrics-exporter
    app.kubernetes.io/component: reconciler
  annotations:
    package-operator.run/phase: reconciler
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: ebs-metrics-reconciler
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ebs-metrics-reconciler
        app.kubernetes.io/part-of: ebs-metrics-exporter
        app.kubernetes.io/component: reconciler
    spec:
      serviceAccountName: ebs-metrics-exporter
      containers:
      - name: reconciler
        image: {{ .config.image }}
        imagePullPolicy: Always
        command:
        - /usr/local/bin/ebs-metrics-exporter
        args:
        - --mode=reconciler
        - --reconciler-namespace={{ .config.namespace }}
        - --reconciler-interval=30
        resources:
          requests:
            memory: "64Mi"
            cpu: "10m"
          limits:
            memory: "128Mi"
            cpu: "100m"
        securityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          capabilities:
            drop:
            - ALL
          seccompProfile:
            type: RuntimeDefault

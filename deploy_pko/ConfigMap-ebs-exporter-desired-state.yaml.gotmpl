apiVersion: v1
kind: ConfigMap
metadata:
  name: ebs-metrics-exporter-desired-state
  namespace: {{ .config.namespace }}
  labels:
    app.kubernetes.io/name: ebs-metrics-exporter
    app.kubernetes.io/part-of: ebs-metrics-exporter
    app.kubernetes.io/component: reconciler
  annotations:
    package-operator.run/phase: reconciler
data:
  # Image version to enforce (for DaemonSet reconciliation)
  image: "{{ .config.image }}"

  # Desired ConfigMap data - must match ConfigMap-ebs-exporter-config.yaml.gotmpl exactly
  # This is used by the reconciler to detect and revert drift
  config.yaml: |
    metrics:
      pollingIntervalSeconds: 60

    deviceDiscovery:
      mode: auto
      # skipPVCMapping: false enables PVC lookups for pod/namespace/pvc_* labels
      # Set to true to reduce API load (metrics will only have volume_id, volume_type)
      skipPVCMapping: false

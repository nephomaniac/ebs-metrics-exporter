# Local Development Environment Configuration
# Copy this file to .env.local and set your values
# .env.local is git-ignored and safe for personal settings

# ============================================
# Required: Image Repository
# ============================================
# Your Quay.io username or organization
# Used for: quay.io/${IMAGE_REPOSITORY}/ebs-metrics-exporter:tag
IMAGE_REPOSITORY=

# ============================================
# Optional: Cluster Safety
# ============================================
# Expected cluster identifier (prevents wrong-cluster deployments)
# Extract from: oc whoami --show-server | grep -o '[^.]*' | head -1
# Example: my-test-cluster
EXPECTED_CLUSTER=

# ============================================
# Optional: Custom Image Tags
# ============================================
# Override default image tag (default: latest)
# OPERATOR_IMAGE_TAG=v1.0.0

# ============================================
# Optional: Container Engine
# ============================================
# Container runtime (default: podman)
# CONTAINER_ENGINE=podman

# ============================================
# Optional: Build Settings
# ============================================
# Allow builds from dirty git checkout (default: false)
# ALLOW_DIRTY_CHECKOUT=true

# Enable FIPS mode for builds (default: true)
# FIPS_ENABLED=true

FROM scratch

LABEL com.redhat.component="openshift-ebs-metrics-exporter" \
      io.k8s.description="EBS Metrics Exporter for OpenShift Dedicated" \
      description="EBS Metrics Exporter for OpenShift Dedicated" \
      distribution-scope="public" \
      name="openshift/ebs-metrics-exporter" \
      url="https://github.com/nephomaniac/ebs-metrics-exporter" \
      vendor="Red Hat, Inc." \
      release="v0.0.0" \
      version="v0.0.0"

COPY * /package/
